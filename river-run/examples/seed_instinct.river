; Seed a small Instinct fixture through the same soil:records WIT a Spore uses.
(defun seed-instinct ()
  (let ((now (now-ms)))
    (upsert-record "device:avery" "pine:1" "fungos.device/state.v1"
      (list (list :kind "wearable.watch")
            (list :model "PineTime")
            (list :owner "avery")
            (list :bridge "home-pi")
            (list :charging #f)
            (list :link "connected")
            (list :battery_percent 72)
            (list :last_seen_ms now))
      now)
    (upsert-record "signal:avery" "pine:1:hr" "signal.sample.v1"
      (list (list :kind "body.hr.v1")
            (list :source_device "pine:1")
            (list :wearer "avery")
            (list :observed_at now)
            (list :quality (list (list :state "good")))
            (list :value (list (list :bpm 61) (list :contact "good"))))
      now)

    (upsert-record "device:avery" "ring:left" "fungos.device/state.v1"
      (list (list :kind "wearable.ring")
            (list :model "COLMI Ring 2")
            (list :owner "avery")
            (list :bridge "s22")
            (list :charging #f)
            (list :link "connected")
            (list :battery_percent 81)
            (list :last_seen_ms now))
      now)
    (upsert-record "signal:avery" "ring:left:motion" "signal.sample.v1"
      (list (list :kind "body.motion.v1")
            (list :source_device "ring:left")
            (list :wearer "avery")
            (list :observed_at now)
            (list :quality (list (list :state "good")))
            (list :value (list (list :moving #t))))
      now)

    (upsert-record "device:avery" "omi:1" "fungos.device/state.v1"
      (list (list :kind "wearable.pendant")
            (list :model "Omi")
            (list :owner "avery")
            (list :bridge "s22")
            (list :charging #f)
            (list :link "connected")
            (list :battery_percent 64)
            (list :last_seen_ms now))
      now)
    (upsert-record "signal:avery" "omi:1:button" "signal.sample.v1"
      (list (list :kind "device.button.v1")
            (list :source_device "omi:1")
            (list :wearer "avery")
            (list :observed_at now)
            (list :quality (list (list :state "good")))
            (list :value nil))
      now)

    (upsert-record "device:avery" "az09:1" "fungos.device/state.v1"
      (list (list :kind "wearable.earbud")
            (list :model "AZ09")
            (list :owner "avery")
            (list :bridge "s22")
            (list :charging #f)
            (list :link "connected")
            (list :battery_percent 90)
            (list :last_seen_ms now))
      now)
    (upsert-record "signal:avery" "az09:1:audio" "signal.sample.v1"
      (list (list :kind "audio.segment.v1")
            (list :source_device "az09:1")
            (list :wearer "avery")
            (list :observed_at now)
            (list :quality (list (list :state "good")))
            (list :value (list (list :active #t))))
      now)))

(seed-instinct)
