(define-package "soil:principal@0.1.0" :base "soil:principal" :version "0.1.0")

(define-enum soil:principal/kind human agent service)

(define-enum soil:principal/error denied not-ready stale invalid unavailable)

(define-record soil:principal/identity
  (actor string)
  (kind soil:principal/kind)
  (display-name (option string))
  (device (option string))
  (teams (list string))
  (roles (list string))
  (generation u64)
)

(define-record soil:principal/signing-key-info
  (algorithm string)
  (fingerprint string)
  (reference string)
  (generation u64)
)

(define-function soil:principal/current
  ()
  -> (result soil:principal/identity soil:principal/error)
  :grant "soil:principal" :version "0.1.0")

(define-function soil:principal/signing-key
  ()
  -> (result (option soil:principal/signing-key-info) soil:principal/error)
  :grant "soil:principal" :version "0.1.0")

